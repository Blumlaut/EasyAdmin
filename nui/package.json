{
  "name": "easyadmin-nui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:browser": "vite --open ?dev",
    "build": "tsc && vite build",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "lint": "echo 'ESLint disabled: typescript-eslint does not support TS 7 (tsgo) yet. Run npm run typecheck for type validation.' && exit 0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "check": "npm run lint && npm run lint:css && npm run typecheck && npm run test",
    "extract:i18n": "node ../tools/extract-i18n.mjs",
    "find:untranslated": "node ../tools/find-untranslated.mjs",
    "duplication": "jscpd src/"
  },
  "dependencies": {
    "@citizenfx/three": "^0.100.0",
    "chart.js": "^4.6.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "peerjs": "^1.5.5",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.14.0",
    "jscpd": "^5.4.1",
    "jsdom": "^31.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
